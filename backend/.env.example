# Copia este archivo a `.env` (en la carpeta backend/) y ajusta los valores.
# `.env` nunca se commitea (ver .gitignore).

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# En desarrollo local, estos valores apuntan al servicio `db` del
# docker-compose (Postgres local). En producción (Render), las MISMAS
# variables de entorno apuntan a Supabase — el código de settings no cambia.
DB_NAME=ruta_agustina
DB_USER=ruta_agustina
DB_PASSWORD=ruta_agustina
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60

# Ejemplo de valores para producción (Supabase) — NO usar en local:
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Dominio(s) del frontend en Vercel. Separar múltiples orígenes con coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Google
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-is
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# ---------------------------------------------------------------------------
# Rate limiting (throttling de DRF)
# ---------------------------------------------------------------------------
THROTTLE_RATE_ANON=100/day
THROTTLE_RATE_USER=1000/day

# ---------------------------------------------------------------------------
# Seguridad (solo tiene efecto en config/settings/production.py)
# ---------------------------------------------------------------------------
SECURE_HSTS_SECONDS=2592000
